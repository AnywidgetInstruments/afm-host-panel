  "panels": [
    { "type": "row", "id": 100, "title": "Demonstration widgets (examples/)", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },
    {
      "type": "scelles-afmhost-panel",
      "id": 1,
      "title": "Counter (write-back to $count)",
      "description": "examples/counter.js: a click saves value, written to the dashboard variable count.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 7 },
      "options": {
        "mode": "builtin",
        "widget": "examples:Counter",
        "staticTraits": "{\n  \"label\": \"Clicks\",\n  \"step\": 1\n}",
        "bindings": [
          { "trait": "value", "source": "variable", "variable": "count", "parse": "number", "writeBack": "variable" }
        ],
        "sizeTraits": false,
        "isolation": "shadow",
        "showDiagnostics": true
      }
    },
    {
      "type": "text",
      "id": 2,
      "title": "Dashboard variable",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 7 },
      "options": {
        "mode": "markdown",
        "content": "The counter writes its value to the dashboard variable `count`.\n\n**count = <span data-testid=\"count-value\">$count</span>**"
      }
    },
    {
      "type": "scelles-afmhost-panel",
      "id": 3,
      "title": "Gauge (last TestData value)",
      "description": "examples/gauge.js: value is the last non-null value of the query.",
      "datasource": { "type": "grafana-testdata-datasource", "uid": "trlxrdZVk" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-testdata-datasource", "uid": "trlxrdZVk" },
          "scenarioId": "csv_metric_values",
          "stringInput": "10,20,30,55",
          "alias": "level"
        }
      ],
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 7 },
      "options": {
        "mode": "builtin",
        "widget": "examples:Gauge",
        "staticTraits": "{\n  \"label\": \"TestData level\",\n  \"unit\": \"%\",\n  \"min\": 0,\n  \"max\": 100\n}",
        "bindings": [{ "trait": "value", "source": "field", "reducer": "lastNotNull" }],
        "sizeTraits": false,
        "isolation": "shadow",
        "showDiagnostics": true
      }
    },
    {
      "type": "scelles-afmhost-panel",
